{
  "name": "pawsome-elements-backend",
  "main": "index.js",
  "scripts": {
    "eslint": "node_modules/.bin/eslint src/",
    "test": "jest",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "start": "nodemon --signal SIGTERM --watch 'src/**/*.ts' --exec 'node' --inspect -r ts-node/register src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsc -p .",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org kwokka --project pawsome-elements-backend ./dist && sentry-cli sourcemaps upload --org kwokka --project pawsome-elements-backend ./dist",
    "scripts:rating_simulation": "ts-node scripts/rating_simulation.ts",
    "scripts:essence_simulation": "ts-node scripts/essence_simulation.ts"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@kwokka/entities": "*",
    "@kwokka/sdk-node": "*",
    "@kwokka/utils": "*",
    "@sentry/cli": "2.39.0",
    "@sentry/node": "8.52.0",
    "@sentry/profiling-node": "8.52.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "git-describe": "4.1.1",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.14.1",
    "@typescript-eslint/eslint-plugin": "7.7.0",
    "@typescript-eslint/parser": "7.7.0",
    "eslint": "8.56.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-unused-imports": "3.1.0",
    "jest": "29.7.0",
    "lint-staged": "15.5.1",
    "nodemon": "3.1.10",
    "prettier": "3.5.3",
    "ts-jest": "29.3.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "*.ts": "eslint --fix -c=.eslintrc.js"
  }
}
