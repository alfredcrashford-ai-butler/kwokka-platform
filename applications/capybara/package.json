{
  "name": "@kwokka/capybara",
  "main": "index.js",
  "scripts": {
    "eslint": "node_modules/.bin/eslint src/",
    "test": "jest",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "start": "nodemon --watch 'src/**/*.ts' --exec 'node' --inspect -r ts-node/register src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsc -p .",
    "buildim": "docker build . -t kwokka/capybara:$npm_package_version"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "joi": "17.13.3",
    "@kwokka/common-node": "*",
    "@kwokka/entities": "*",
    "@kwokka/rights": "*",
    "@kwokka/utils": "*",
    "bson": "6.10.3",
    "express": "5.1.0",
    "inversify": "7.5.0",
    "mongoose": "8.13.2",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.14.1",
    "@typescript-eslint/eslint-plugin": "7.7.0",
    "@typescript-eslint/parser": "7.7.0",
    "eslint": "8.56.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-unused-imports": "3.1.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "15.5.1",
    "nodemon": "3.1.9",
    "prettier": "3.5.3",
    "ts-jest": "29.3.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "*.ts": "eslint --fix -c=.eslintrc.js"
  }
}