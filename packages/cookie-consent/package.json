{
  "name": "@kwokka/cookie-consent",
  "scripts": {
    "test": "jest lib/",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write lib/",
    "build": "vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwokka/cookie-consent.git"
  },
  "typings": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "main": "./dist/kwokka-cookie-consent.umd.js",
  "module": "./dist/kwokka-cookie-consent.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kwokka-cookie-consent.mjs",
      "require": "./dist/kwokka-cookie-consent.umd.js"
    },
    "./style.css": "./dist/kwokka-cookie-consent.css"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "@typescript-eslint/eslint-plugin": "8.29.1",
    "@typescript-eslint/parser": "8.29.1",
    "eslint": "9.24.0",
    "lint-staged": "15.5.1",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-dts": "4.5.4"
  },
  "lint-staged": {
    "*.ts": "eslint --fix -c=.eslintrc.js"
  }
}