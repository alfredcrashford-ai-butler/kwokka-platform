    "@typescript-eslint/parser": "8.29.1",
    "eslint": "9.24.0",
    "jest": "29.7.0",
    "lint-staged": "15.5.1",
    "prettier": "3.5.3",
    "ts-jest": "29.3.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "*.ts": "eslint --fix -c=.eslintrc.js"
