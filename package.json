{
  "name": "@kwokka/platform",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "applications/*",
    "packages/*",
    "games/*",
    "games/*/frontend",
    "games/*/backend",
    "games/*/landing"
  ],
  "scripts": {
    "dev:platform": "node scripts/dev-platform.js",
    "dev:game": "node scripts/dev-game.js",
    "release": "node scripts/release.js",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "inquirer": "^9.2.12"
  }
}
